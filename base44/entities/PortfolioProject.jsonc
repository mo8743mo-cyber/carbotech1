{
  "name": "PortfolioProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "automotive",
        "motorcycle",
        "drone",
        "industrial",
        "marine",
        "prototype",
        "custom"
      ]
    },
    "description": {
      "type": "string"
    },
    "materials": {
      "type": "string"
    },
    "process": {
      "type": "string"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_url": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ]
}